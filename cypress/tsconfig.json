{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"types": ["cypress", "node"],
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true
	},
	"include": ["**/*.ts", "../cypress.config.ts"]
}
